{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "windows": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/session-start.ps1",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "windows": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/quality-gate.ps1",
        "timeout": 120
      }
    ]
  }
}
