# LoftDesk v5.9 — environment variables
# Copy to .env.local and fill in real values.
# Frontend vars (VITE_*) are inlined at build time by Vite — safe in browser.
# Backend-only vars (no VITE_ prefix) are used exclusively by Netlify Functions — never exposed to browser.

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite build-time) — set in Netlify UI → Site settings → Environment
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project (required for production — without these the app runs in demo mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Data mode: omit or set to "live" for production, "demo" for local demo mode
VITE_DATA_MODE=live

# Stripe publishable key (required for checkout button to work)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe price IDs for plans (required — checkout button reads these)
VITE_STRIPE_BUSINESS_PRICE_ID=price_...

# Optional: base URL used in settings/release info display
# VITE_PUBLIC_BASE_URL=https://app.loftdesk.pl

# Required for Capacitor iOS/Android native builds — makes Netlify function URLs
# absolute so they resolve inside the native WebView. Also used by getAppOrigin()
# for Supabase auth redirectTo. Set in .env.production (auto-loaded by Vite for builds).
# VITE_APP_URL=https://loftdesk.pl

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND ONLY — Netlify Functions (set in Netlify UI, never in .env for frontend)
# ──────────────────────────────────────────────────────────────────────────────

# Supabase service role key — used by Netlify functions only (NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Stripe secret key — server-only (NEVER expose to browser)
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret (copy from Stripe Dashboard → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — backend price allow-list (must match the frontend IDs above)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# OpenAI API key — optional; enables AI-powered invoice OCR in parse-invoice function
# Without this, invoice parsing falls back to regex extraction (graceful degradation)
# OPENAI_API_KEY=sk-...

# SITE_URL — primary production URL (Netlify auto-sets URL for preview deploys)
# Only needed if your custom domain differs from what Netlify sets automatically
# SITE_URL=https://app.loftdesk.pl

# ──────────────────────────────────────────────────────────────────────────────
# CLIENT PORTAL — magic link invitations (client-identify Netlify function)
# ──────────────────────────────────────────────────────────────────────────────

# Resend transactional email (optional but recommended for Polish invite emails)
# Without RESEND_API_KEY, the function falls back to Supabase built-in SMTP OTP.
# Get your key at https://resend.com → API Keys
RESEND_API_KEY=re_...

# Verified sender address in Resend — must match a domain verified in Resend.
# Falls back to noreply@loftdesk.pl if not set or invalid.
RESEND_FROM_EMAIL=noreply@yourdomain.pl

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE AUTH — redirect URL allowlist (configure in Supabase Dashboard)
# ──────────────────────────────────────────────────────────────────────────────
# In Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:          https://app.loftdesk.pl
#   Redirect URLs:     https://app.loftdesk.pl/auth/callback
#
# client-identify.ts constructs the magic link redirectTo as:
#   ${URL ?? DEPLOY_URL ?? 'https://app.loftdesk.pl'}/auth/callback?mode=client&project_id=<id>
#
# URL and DEPLOY_URL are injected automatically by Netlify on every deploy.
# No manual env var needed unless your custom domain differs from the Netlify
# deploy URL (unlikely in production — the fallback covers it).
