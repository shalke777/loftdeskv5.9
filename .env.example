# LoftDesk v5.9 — environment variables
# Copy to .env and fill in real values for production.
# Demo mode works without Supabase — set VITE_DATA_MODE=demo.

# Supabase project settings (required for production)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Data mode: "demo" uses localStorage, "supabase" uses real backend
VITE_DATA_MODE=demo

# Optional: public base URL for portal links (defaults to window.location.origin)
# VITE_PUBLIC_BASE_URL=https://app.loftdesk.pl
