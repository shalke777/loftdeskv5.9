# LoftDesk v5.9 — environment variables
# Copy to .env.local and fill in real values.
# Frontend vars (VITE_*) are inlined at build time by Vite — safe in browser.
# Backend-only vars (no VITE_ prefix) are used exclusively by Netlify Functions — never exposed to browser.

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite build-time) — set in Netlify UI → Site settings → Environment
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project (required for production — without these the app runs in demo mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Data mode: omit or set to "live" for production, "demo" for local demo mode
VITE_DATA_MODE=live

# Stripe publishable key (required for checkout button to work)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe price IDs for plans (required — checkout button reads these)
VITE_STRIPE_BUSINESS_PRICE_ID=price_...

# Optional: base URL used in settings/release info display
# VITE_PUBLIC_BASE_URL=https://app.loftdesk.pl

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND ONLY — Netlify Functions (set in Netlify UI, never in .env for frontend)
# ──────────────────────────────────────────────────────────────────────────────

# Supabase service role key — used by Netlify functions only (NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Stripe secret key — server-only (NEVER expose to browser)
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret (copy from Stripe Dashboard → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — backend price allow-list (must match the frontend IDs above)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# OpenAI API key — optional; enables AI-powered invoice OCR in parse-invoice function
# Without this, invoice parsing falls back to regex extraction (graceful degradation)
# OPENAI_API_KEY=sk-...

# SITE_URL — primary production URL (Netlify auto-sets URL for preview deploys)
# Only needed if your custom domain differs from what Netlify sets automatically
# SITE_URL=https://app.loftdesk.pl
