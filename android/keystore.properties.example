# =============================================================================
# Android release signing — local secrets.
# =============================================================================
# Copy this file to `keystore.properties` (gitignored) and fill in actual values.
# Generate keystore once:
#   keytool -genkey -v -keystore loftdesk-release.keystore \
#     -alias loftdesk -keyalg RSA -keysize 2048 -validity 10000
#
# Store loftdesk-release.keystore OUTSIDE the repo (e.g. ~/.android-keystores/).
# Lose it = lose ability to update the app on Play Store. Back it up.
# =============================================================================

storeFile=/absolute/path/to/loftdesk-release.keystore
storePassword=CHANGE_ME
keyAlias=loftdesk
keyPassword=CHANGE_ME
